# Copy to .env.local for local development. Real values live in Vercel → Settings → Environment Variables.
# Never put real values in this file.

# Public origin of the app, e.g. https://sound-journal.vercel.app (used for OAuth and the MCP connector URL)
APP_ORIGIN=

# Owner login (M3)
APP_PASSWORD=
SESSION_SECRET=

# Neon Postgres (M2) — set automatically by the Vercel–Neon integration
DATABASE_URL=

# Upstash Vector (M6)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# MusicBrainz (M7) — contact info for the required User-Agent
MUSICBRAINZ_CONTACT=

# Cron jobs (search re-sync) — shared secret checked by /api/cron/*
CRON_SECRET=

# Feature flags, e.g. FEATURE_TASTE_MAP=on
