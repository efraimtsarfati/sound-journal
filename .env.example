# Copy to .env.local for local development. Real values live in Vercel → Settings → Environment Variables.
# Never put real values in this file.

# Public origin of the app, no trailing slash, e.g. https://sound-journal.vercel.app (OAuth issuer and MCP connector URL; connecting an agent fails closed without it)
APP_ORIGIN=

# Owner login (M3)
APP_PASSWORD=
SESSION_SECRET=

# Neon Postgres (M2) — set automatically by the Vercel–Neon integration
DATABASE_URL=
# Direct (non-pooled) connection, used by drizzle-kit migrate; falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=

# Upstash Vector (M6)
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# MusicBrainz (M7) — contact info for the required User-Agent
MUSICBRAINZ_CONTACT=

# Cron jobs (daily cleanup and, later, search re-sync): shared secret checked by /api/cron/*; at least 16 random chars
CRON_SECRET=

# Feature flags, e.g. FEATURE_TASTE_MAP=on
